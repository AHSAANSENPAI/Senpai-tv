# Base URL of your AniKotoAPI deployment (https://github.com/Shineii86/AniKotoAPI).
# Every request in lib/api.ts is built from this value — nothing is hard-coded.
# Example: ANIKOTO_API_URL=https://your-anikoto-instance.example.com
ANIKOTO_API_URL=https://your-anikoto-instance.example.com

# Optional: comma-separated list of hostnames that VideoPlayer/streaming.ts is
# allowed to request video from, in addition to the demo source. Only add
# hosts you have verified are authorized/licensed streaming providers.
# Example: NEXT_PUBLIC_AUTHORIZED_STREAM_HOSTS=stream.myauthorizedcdn.com,videos.mylicensedpartner.com
NEXT_PUBLIC_AUTHORIZED_STREAM_HOSTS=

# Access code required before anyone can use the site (middleware.ts gates
# every route behind app/access-gate until this is entered correctly).
# Defaults to 1066924 if unset — override this for a real deployment.
SITE_ACCESS_CODE=1066924
